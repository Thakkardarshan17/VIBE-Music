{
  "name": "vibe-music",
  "version": "1.0.0",
  "private": true,
  "description": "VIBE MUSIC - Complete Full-Stack Music Streaming Web Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:api": "npx esbuild server/src/index.ts --bundle --platform=node --format=esm --outfile=api/index.js --external:@prisma/client",
    "start": "cd server && npm start",
    "test": "cd server && npx tsx src/test/integration.test.ts",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  }
}
