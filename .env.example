# ===================================================
# VIBE MUSIC - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL Prisma connection)
# Example: postgresql://username:password@localhost:5432/vibemusic?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vibemusic?schema=public"

# Authentication
JWT_SECRET="vibe_music_jwt_super_secure_secret_key_2026_9876543210"
JWT_EXPIRES_IN="7d"

# External Music APIs
# Jamendo Client ID (Default public developer client id provided for immediate real audio playback)
JAMENDO_CLIENT_ID="5663f747"

# YouTube Data API Key (Optional: for direct YouTube search API quota; YouTube embeds work out of the box)
YOUTUBE_API_KEY=""

# Spotify Developer API (Optional: for official Spotify track catalog search)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000/api"

